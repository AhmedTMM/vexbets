{
  "name": "vexbets",
  "private": true,
  "workspaces": [
    "contract",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "npm run build -w backend"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  }
}
