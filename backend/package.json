{
  "name": "@vexbets/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "e2e": "next build && vitest run -c vitest.e2e.config.ts",
    "e2e:only": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@google/genai": "^3.3.0",
    "@vexbets/contract": "*",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
